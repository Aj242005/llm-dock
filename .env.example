# Demo mode works without API credentials.
LLM_DOCKING_MODE=heuristic
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LLM_DOCKING_LLM_MODEL=gpt-4o
LLM_DOCKING_LLM_MODEL_GROQ=llama-3.1-8b-instant
LLM_DOCKING_LLM_MODEL_OPENROUTER=meta-llama/llama-3.1-8b-instant
LLM_DOCKING_LLM_TIMEOUT_S=20
LLM_DOCKING_LLM_MAX_RETRIES=1
LLM_DOCKING_LLM_RETRY_BACKOFF_S=0.25
# Set only for your own OpenAI-compatible endpoint.
# LLM_DOCKING_LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_DOCKING_RL_MODEL_PATH=proofs/kaggle-final-seed-42/ppo_dock.zip
LLM_DOCKING_RL_NORMALIZE_PATH=proofs/kaggle-final-seed-42/ppo_dock_vecnormalize.pkl
